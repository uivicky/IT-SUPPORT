  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|robots\\.txt|sitemap\\.xml|assets/|google4b0bbeb71306411b\\.html|BingSiteAuth\\.xml).*)",
      "destination": "/index.html"
    }
  ]
}
