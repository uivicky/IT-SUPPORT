# GEMINI_API_KEY: Required for IT SUPPORT AI troubleshooting assistant (server-side only).
# Configure in Google AI Studio (Settings > Secrets) or Vercel Environment Variables.
# Never expose this key in client-side VITE_ variables.
GEMINI_API_KEY=

# APP_URL: Canonical base URL where IT SUPPORT is hosted (e.g., https://it-support-engg.vercel.app).
APP_URL=https://it-support-engg.vercel.app

# VITE_GA_MEASUREMENT_ID: Optional Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX).
# When provided, GA4 automatically initializes with privacy protection and DNT respect.
VITE_GA_MEASUREMENT_ID=

# INDEXNOW_API_KEY: Optional server-side API key for Instant Indexing with Bing and Yandex via /api/indexnow.
INDEXNOW_API_KEY=
