# GEMINI_API_KEY: Required for IT SUPPORT AI troubleshooting assistant (server-side only).
# Configure in Google AI Studio (Settings > Secrets) or Vercel Environment Variables.
# Never expose this key in client-side VITE_ variables.
GEMINI_API_KEY=

# APP_URL: Canonical base URL where IT SUPPORT is hosted (e.g., https://itsupport.example.com).
APP_URL=http://localhost:3000
